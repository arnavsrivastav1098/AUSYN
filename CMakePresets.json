{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc-qt",
      "displayName": "Windows x64 · MSVC · Qt 6",
      "description": "Uses the Visual Studio 2022 generator and the matching MSVC Qt kit.",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QTDIR}",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/dist"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-release",
      "displayName": "Build Ausyn (Release)",
      "configurePreset": "windows-msvc-qt",
      "configuration": "Release"
    }
  ]
}
